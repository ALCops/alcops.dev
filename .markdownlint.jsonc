// markdownlint config for content/ prose. Run via markdownlint-cli2 in
// .github/workflows/build.yaml. Rules not listed here stay at their defaults,
// so new violations of them still fail the PR gate.
//
// Every rule disabled below is currently violated by existing content. Two
// groups: (1) deliberate site conventions we will not enforce, and (2)
// pre-existing debt we may tighten later (fix content, then re-enable).
{
  "default": true,

  // (1) Deliberate site conventions — leave off.
  "MD013": false, // line-length: prose/tables run long by design
  "MD033": false, // no-inline-html: Hugo shortcodes & raw HTML (unsafe = true)
  "MD025": false, // single-h1: front-matter title + body H1 coexist
  "MD001": false, // heading-increment: pages open at ### under the H1 title
  "MD060": false, // table-column-style
  "MD055": false, // table-pipe-style
  "MD056": false, // table-column-count

  // (2) Pre-existing debt — candidates to fix and re-enable later.
  "MD022": false, // blanks-around-headings
  "MD031": false, // blanks-around-fences
  "MD032": false, // blanks-around-lists
  "MD012": false, // no-multiple-blanks
  "MD009": false, // no-trailing-spaces
  "MD018": false, // no-missing-space-atx
  "MD026": false, // no-trailing-punctuation in headings
  "MD034": false, // no-bare-urls
  "MD036": false, // no-emphasis-as-heading
  "MD038": false, // no-space-in-code-span
  "MD040": false, // fenced-code-language
  "MD046": false, // code-block-style (indented vs fenced)
  "MD047": false  // single-trailing-newline
}
